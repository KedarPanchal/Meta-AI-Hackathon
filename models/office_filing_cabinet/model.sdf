                <pose>0 -0.315 1.12 0 0 0</pose>
                <geometry><box><size>0.46 0.02 0.38</size></box></geometry>
                <material><diffuse>0.50 0.51 0.53 1</diffuse><specular>0.2 0.2 0.2 1</specular></material>
            </visual>

            <visual name="pull_1">
