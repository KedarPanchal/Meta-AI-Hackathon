<?xml version="1.0" ?>
<sdf version="1.6">
    <!-- Three-drawer filing cabinet, 0.5 x 0.62 m footprint and 1.28 m tall, with
         drawer fronts and pulls on the -y face. -->
    <model name="office_filing_cabinet">
        <static>true</static>
        <link name="link">
            <collision name="body_collision">
                <pose>0 0 0.64 0 0 0</pose>
                <geometry><box><size>0.50 0.62 1.28</size></box></geometry>
            </collision>
            <visual name="body">
                <pose>0 0 0.64 0 0 0</pose>
                <geometry><box><size>0.50 0.62 1.28</size></box></geometry>
                <material><diffuse>0.42 0.43 0.45 1</diffuse><specular>0.2 0.2 0.2 1</specular></material>
            </visual>

            <visual name="drawer_1">
                <pose>0 -0.315 0.28 0 0 0</pose>
                <geometry><box><size>0.46 0.02 0.38</size></box></geometry>
