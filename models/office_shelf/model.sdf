<?xml version="1.0" ?>
<sdf version="1.6">
    <!-- Office shelving unit: 1.0 m wide, 0.42 m deep and 1.85 m tall steel
         frame with four shelves, a back panel and a bit of archive clutter
         (boxes, binders, a stack of paper) on the middle shelves. The back is on
         the +y side, so a unit against the north wall takes yaw pi and one
         against the west wall takes yaw 1.5708.

         Origin is on the floor at the centre of the footprint. Primitive
         geometry for the same reason as the rest of the furniture: it reads
         correctly in a dusty, half-lit room and collides cheaply. -->
    <model name="office_shelf">
        <static>true</static>
        <link name="link">
            <collision name="collision">
                <pose>0 0 0.925 0 0 0</pose>
                <geometry>
                    <box>
                        <size>1.00 0.42 1.85</size>
                    </box>
                </geometry>
            </collision>

            <visual name="back">
                <pose>0 0.20 0.925 0 0 0</pose>
                <geometry><box><size>0.98 0.02 1.83</size></box></geometry>
                <material><diffuse>0.54 0.55 0.53 1</diffuse><specular>0.10 0.10 0.10 1</specular></material>
            </visual>
            <visual name="side_left">
                <pose>-0.49 0 0.925 0 0 0</pose>
                <geometry><box><size>0.02 0.42 1.85</size></box></geometry>
                <material><diffuse>0.33 0.34 0.36 1</diffuse><specular>0.30 0.30 0.30 1</specular></material>
            </visual>
            <visual name="side_right">
                <pose>0.49 0 0.925 0 0 0</pose>
                <geometry><box><size>0.02 0.42 1.85</size></box></geometry>
                <material><diffuse>0.33 0.34 0.36 1</diffuse><specular>0.30 0.30 0.30 1</specular></material>
            </visual>

            <!-- Four shelves plus a top cap. -->
            <visual name="shelf_1">
                <pose>0 0 0.06 0 0 0</pose>
                <geometry><box><size>0.96 0.40 0.025</size></box></geometry>
                <material><diffuse>0.46 0.47 0.45 1</diffuse><specular>0.15 0.15 0.15 1</specular></material>
            </visual>
            <visual name="shelf_2">
                <pose>0 0 0.62 0 0 0</pose>
                <geometry><box><size>0.96 0.40 0.025</size></box></geometry>
                <material><diffuse>0.46 0.47 0.45 1</diffuse><specular>0.15 0.15 0.15 1</specular></material>
            </visual>
            <visual name="shelf_3">
                <pose>0 0 1.20 0 0 0</pose>
                <geometry><box><size>0.96 0.40 0.025</size></box></geometry>
                <material><diffuse>0.46 0.47 0.45 1</diffuse><specular>0.15 0.15 0.15 1</specular></material>
            </visual>
            <visual name="shelf_4">
                <pose>0 0 1.78 0 0 0</pose>
                <geometry><box><size>0.96 0.40 0.025</size></box></geometry>
                <material><diffuse>0.46 0.47 0.45 1</diffuse><specular>0.15 0.15 0.15 1</specular></material>
            </visual>
            <visual name="top_cap">
                <pose>0 0 1.845 0 0 0</pose>
                <geometry><box><size>1.00 0.42 0.02</size></box></geometry>
                <material><diffuse>0.30 0.31 0.33 1</diffuse><specular>0.25 0.25 0.25 1</specular></material>
            </visual>

            <!-- Archive clutter: two boxes on the lower shelf, binders and a
                 paper stack on the middle one, one box up top. -->
            <visual name="box_1">
                <pose>-0.26 -0.02 0.753 0 0 0.05</pose>
                <geometry><box><size>0.36 0.30 0.24</size></box></geometry>
                <material><diffuse>0.58 0.52 0.40 1</diffuse><specular>0.05 0.05 0.05 1</specular></material>
            </visual>
            <visual name="box_2">
                <pose>0.16 -0.04 0.745 0 0 0</pose>
                <geometry><box><size>0.26 0.28 0.22</size></box></geometry>
                <material><diffuse>0.50 0.46 0.38 1</diffuse><specular>0.05 0.05 0.05 1</specular></material>
            </visual>
            <visual name="binder_1">
                <pose>0.02 -0.02 1.345 0 0 0</pose>
                <geometry><box><size>0.06 0.26 0.29</size></box></geometry>
                <material><diffuse>0.34 0.13 0.12 1</diffuse><specular>0.10 0.10 0.10 1</specular></material>
            </visual>
            <visual name="binder_2">
                <pose>0.09 -0.02 1.335 0 0 0</pose>
                <geometry><box><size>0.06 0.26 0.27</size></box></geometry>
                <material><diffuse>0.13 0.19 0.34 1</diffuse><specular>0.10 0.10 0.10 1</specular></material>
            </visual>
            <visual name="binder_3">
                <pose>0.16 -0.02 1.350 0 0 0</pose>
                <geometry><box><size>0.06 0.26 0.30</size></box></geometry>
                <material><diffuse>0.22 0.24 0.20 1</diffuse><specular>0.10 0.10 0.10 1</specular></material>
            </visual>
            <visual name="binder_4">
                <pose>0.23 -0.02 1.325 0 0 0</pose>
                <geometry><box><size>0.06 0.26 0.25</size></box></geometry>
                <material><diffuse>0.30 0.28 0.16 1</diffuse><specular>0.10 0.10 0.10 1</specular></material>
            </visual>
            <visual name="paper_stack">
                <pose>-0.30 -0.05 1.245 0 0 0.12</pose>
                <geometry><box><size>0.28 0.21 0.05</size></box></geometry>
                <material><diffuse>0.74 0.73 0.68 1</diffuse><specular>0.03 0.03 0.03 1</specular></material>
            </visual>
            <visual name="box_3">
                <pose>-0.14 0 1.885 0 0 0.08</pose>
                <geometry><box><size>0.32 0.26 0.19</size></box></geometry>
                <material><diffuse>0.55 0.49 0.38 1</diffuse><specular>0.05 0.05 0.05 1</specular></material>
            </visual>
        </link>
    </model>
</sdf>
