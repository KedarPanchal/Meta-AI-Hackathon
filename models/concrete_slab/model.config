<?xml version="1.0"?>

<model>
  <name>Concrete Slab</name>
  <version>1.0</version>
  <sdf version="1.6">model.sdf</sdf>

  <description>
    Broken concrete slab, 1.9 x 1.25 x 0.18 m, with uneven broken edges, a
    chipped corner, warped faces and exposed rebar. Mesh and procedural concrete
    texture are generated by generate_slab_mesh.py in this directory.
  </description>
</model>
