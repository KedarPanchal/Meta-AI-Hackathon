<?xml version="1.0" ?>
<sdf version="1.6">
    <!-- Broken concrete slab, 1.9 x 1.25 m and 0.18 m thick, with uneven broken
         edges, a chipped corner, warped faces and four lengths of rebar sticking
         out of its -x edge. Two bigger and smaller variants live next to this
         one in models/concrete_slab_wide and models/concrete_slab_chunk.

         Geometry, albedo and normal map are generated by generate_slab_mesh.py
         in this directory, so this is a real slab rather than a box: the edges
         step in and out, the top is warped, and the normals are flat, which is
         how spalled concrete shades. One mesh file serves as visual and
         collision.

         Origin is at the middle of the slab, so it needs to be placed at
         rubble height (roughly 0.25-0.6 m once it is lying on other debris). -->
    <model name="concrete_slab">
        <static>true</static>
        <link name="link">
            <collision name="collision">
                <geometry>
                    <mesh>
                        <uri>meshes/concrete_slab.dae</uri>
                    </mesh>
                </geometry>
                <surface>
                    <friction>
                        <ode>
                            <mu>1.0</mu>
                            <mu2>1.0</mu2>
                        </ode>
                    </friction>
                </surface>
            </collision>
            <visual name="visual">
                <geometry>
                    <mesh>
                        <uri>meshes/concrete_slab.dae</uri>
                    </mesh>
                </geometry>
                <material>
                    <diffuse>1.0 1.0 1.0 1</diffuse>
                    <specular>0.04 0.04 0.04 1</specular>
                    <pbr>
                        <metal>
                            <albedo_map>materials/textures/concrete_albedo.png</albedo_map>
                            <normal_map>materials/textures/concrete_normal.png</normal_map>
                            <metalness>0.0</metalness>
                            <roughness>0.92</roughness>
                        </metal>
                    </pbr>
                </material>
            </visual>

            <!-- Rebar torn out of the broken edge. -->
            <visual name="rebar_1">
                <pose>-0.90 -0.30 0.01 0 1.5708 0.06</pose>
                <geometry><cylinder><radius>0.011</radius><length>0.62</length></cylinder></geometry>
                <material><diffuse>0.33 0.21 0.14 1</diffuse><specular>0.3 0.3 0.3 1</specular></material>
            </visual>
            <visual name="rebar_2">
                <pose>-0.88 -0.10 -0.02 0 1.5200 -0.05</pose>
                <geometry><cylinder><radius>0.011</radius><length>0.54</length></cylinder></geometry>
                <material><diffuse>0.33 0.21 0.14 1</diffuse><specular>0.3 0.3 0.3 1</specular></material>
            </visual>
            <visual name="rebar_3">
                <pose>-0.90 0.12 0.00 0 1.6100 0.10</pose>
                <geometry><cylinder><radius>0.011</radius><length>0.58</length></cylinder></geometry>
                <material><diffuse>0.33 0.21 0.14 1</diffuse><specular>0.3 0.3 0.3 1</specular></material>
            </visual>
            <visual name="rebar_4">
                <pose>-0.87 0.32 -0.01 0 1.4900 0.03</pose>
                <geometry><cylinder><radius>0.011</radius><length>0.50</length></cylinder></geometry>
                <material><diffuse>0.33 0.21 0.14 1</diffuse><specular>0.3 0.3 0.3 1</specular></material>
            </visual>
        </link>
    </model>
</sdf>
