<?xml version="1.0" ?>
<sdf version="1.6">
    <!-- A workstation's computer: 24 inch monitor on a stand, keyboard, mouse
         and a desktop tower. The origin is at the monitor stand's base, so the
         model drops straight onto a 0.75 m desk at z = 0.75.

         The screen carries a dim emissive, which is what a monitor left on looks
         like in a dark, dust-filled room; it is deliberately weak so it reads as
         a glow and not as a light source. -->
    <model name="office_computer">
        <static>true</static>
        <link name="link">
            <visual name="stand_base">
                <pose>0 0.02 0.008 0 0 0</pose>
                <geometry><box><size>0.20 0.17 0.015</size></box></geometry>
                <material><diffuse>0.13 0.13 0.14 1</diffuse><specular>0.2 0.2 0.2 1</specular></material>
            </visual>
            <visual name="stand_column">
                <pose>0 0.03 0.09 0 0 0</pose>
                <geometry><box><size>0.06 0.05 0.16</size></box></geometry>
                <material><diffuse>0.13 0.13 0.14 1</diffuse><specular>0.2 0.2 0.2 1</specular></material>
            </visual>

            <collision name="monitor_collision">
                <pose>0 0 0.30 0 0 0</pose>
                <geometry><box><size>0.56 0.04 0.34</size></box></geometry>
            </collision>
            <visual name="monitor_body">
                <pose>0 0 0.30 0 0 0</pose>
                <geometry><box><size>0.56 0.04 0.34</size></box></geometry>
                <material><diffuse>0.10 0.10 0.11 1</diffuse><specular>0.25 0.25 0.25 1</specular></material>
            </visual>
            <visual name="screen">
                <pose>0 -0.022 0.30 0 0 0</pose>
                <geometry><box><size>0.50 0.004 0.28</size></box></geometry>
                <material>
                    <diffuse>0.08 0.11 0.16 1</diffuse>
                    <specular>0.3 0.3 0.3 1</specular>
                    <emissive>0.10 0.16 0.26 1</emissive>
                </material>
            </visual>

            <visual name="keyboard">
                <pose>0 -0.22 0.012 0 0 0</pose>
                <geometry><box><size>0.44 0.15 0.02</size></box></geometry>
                <material><diffuse>0.16 0.16 0.17 1</diffuse></material>
            </visual>
            <visual name="mouse">
                <pose>0.30 -0.22 0.018 0 0 0</pose>
                <geometry><box><size>0.06 0.10 0.03</size></box></geometry>
                <material><diffuse>0.16 0.16 0.17 1</diffuse></material>
            </visual>

            <collision name="tower_collision">
                <pose>0.40 0.06 0.20 0 0 0</pose>
                <geometry><box><size>0.18 0.44 0.40</size></box></geometry>
            </collision>
            <visual name="tower">
                <pose>0.40 0.06 0.20 0 0 0</pose>
                <geometry><box><size>0.18 0.44 0.40</size></box></geometry>
                <material><diffuse>0.12 0.12 0.13 1</diffuse><specular>0.2 0.2 0.2 1</specular></material>
            </visual>
            <visual name="tower_led">
                <pose>0.40 -0.16 0.33 0 0 0</pose>
                <geometry><box><size>0.10 0.01 0.015</size></box></geometry>
                <material>
                    <diffuse>0.05 0.05 0.05 1</diffuse>
                    <emissive>0.20 0.30 0.12 1</emissive>
                </material>
            </visual>
        </link>
    </model>
</sdf>
