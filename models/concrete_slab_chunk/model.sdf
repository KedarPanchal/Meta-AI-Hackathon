<?xml version="1.0" ?>
<sdf version="1.6">
    <!-- Chunky piece of broken concrete, 1.10 x 0.82 m and 0.26 m thick, snapped
         short at both ends with a broken -x/+y corner and two stubby lengths of
         rebar. Geometry and textures are generated by
         models/concrete_slab/generate_slab_mesh.py (variant
         concrete_slab_chunk); one mesh serves as visual and collision.

         Origin is at the middle, so place it at rubble height. -->
    <model name="concrete_slab_chunk">
        <static>true</static>
        <link name="link">
            <collision name="collision">
                <geometry>
                    <mesh>
                        <uri>meshes/concrete_slab_chunk.dae</uri>
                    </mesh>
                </geometry>
                <surface>
                    <friction>
                        <ode>
                            <mu>1.0</mu>
                            <mu2>1.0</mu2>
                        </ode>
                    </friction>
                </surface>
            </collision>
            <visual name="visual">
                <geometry>
                    <mesh>
                        <uri>meshes/concrete_slab_chunk.dae</uri>
                    </mesh>
                </geometry>
                <material>
                    <diffuse>1.0 1.0 1.0 1</diffuse>
                    <specular>0.04 0.04 0.04 1</specular>
                    <pbr>
                        <metal>
                            <albedo_map>materials/textures/concrete_albedo.png</albedo_map>
                            <normal_map>materials/textures/concrete_normal.png</normal_map>
                            <metalness>0.0</metalness>
                            <roughness>0.92</roughness>
                        </metal>
                    </pbr>
                </material>
            </visual>

            <!-- Rebar stubs out of the broken +x end. -->
            <visual name="rebar_1">
                <pose>0.50 -0.16 0.01 0 1.5708 0.08</pose>
                <geometry><cylinder><radius>0.011</radius><length>0.40</length></cylinder></geometry>
                <material><diffuse>0.33 0.21 0.14 1</diffuse><specular>0.3 0.3 0.3 1</specular></material>
            </visual>
            <visual name="rebar_2">
                <pose>0.49 0.18 -0.02 0 1.5100 -0.06</pose>
                <geometry><cylinder><radius>0.011</radius><length>0.36</length></cylinder></geometry>
                <material><diffuse>0.33 0.21 0.14 1</diffuse><specular>0.3 0.3 0.3 1</specular></material>
            </visual>
        </link>
    </model>
</sdf>
