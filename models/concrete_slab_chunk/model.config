<?xml version="1.0"?>

<model>
  <name>Concrete Slab (chunk)</name>
  <version>1.0</version>
  <sdf version="1.6">model.sdf</sdf>

  <description>
    Chunky broken concrete fragment, 1.10 x 0.82 x 0.26 m, snapped short at both
