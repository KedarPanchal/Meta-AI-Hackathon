<?xml version="1.0"?>

<model>
  <name>Cave Shell</name>
  <version>1.0</version>
  <sdf version="1.6">model.sdf</sdf>

  <description>
    Karst cave passage cut through a rock mass: an uneven mouth 9-11 m across
    opening into a 29 m gallery, a 1.5 m squeeze, and a small chamber with a
    daylight shaft through the roof. Stalactites and stalagmites fill the mouth
    zone and gallery. The mesh is generated procedurally by
    generate_cave_mesh.py in this directory. Rock textures are the
    OpenRobotics "Falling Rocks" set (CC BY 4.0) already used by the boulder
    models in this repository.
  </description>
</model>
