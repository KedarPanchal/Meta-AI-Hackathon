<?xml version="1.0"?>

<model>
  <name>Cave Shell</name>
  <version>1.0</version>
  <sdf version="1.6">model.sdf</sdf>

  <description>
    Karst cave passage cut through a rock mass: a 7 m mouth opening into a
    29 m gallery, a 1.5 m squeeze, and a small chamber with a daylight shaft
    through the roof. The mesh is generated procedurally by
    generate_cave_mesh.py in this directory. Rock textures are the
    OpenRobotics "Falling Rocks" set (CC BY 4.0) already used by the boulder
    models in this repository.
  </description>
</model>
