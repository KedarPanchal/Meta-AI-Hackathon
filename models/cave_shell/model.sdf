<?xml version="1.0" ?>
<sdf version="1.6">
    <!-- Cave shell for the cave rescue world: a karst passage cut through a rock
         mass. The mesh is generated by generate_cave_mesh.py in this directory
         (see its docstring for the layout), so there is no upstream download.

         One mesh is used for both the visual and the collision, so the surface
         the drone camera sees is exactly the surface it bumps into: the
         interior walls, the rock mass behind them, the mouth rim and the
         daylight shaft over the trapped-person chamber.

         Older gz-physics builds may ignore mesh collisions for non-static
         models; this model is static, which every engine supports.

         Textures are the OpenRobotics "Falling Rocks" set already used by
         rock_01..rock_06 (CC BY 4.0), copied here so the model loads offline.
         UVs are generated with the mesh: four wraps around the passage and one
         repeat every 3 m along it, at a scale that keeps the 2 m rock scan from
         reading as an obvious repeat. -->
    <model name="cave_shell">
        <static>true</static>
        <link name="link">
            <collision name="collision">
                <geometry>
                    <mesh>
                        <uri>meshes/cave_shell.dae</uri>
                    </mesh>
                </geometry>
                <surface>
                    <friction>
                        <ode>
                            <mu>1.0</mu>
                            <mu2>1.0</mu2>
                        </ode>
                    </friction>
                </surface>
            </collision>
            <visual name="visual">
                <geometry>
                    <mesh>
                        <uri>meshes/cave_shell.dae</uri>
                    </mesh>
                </geometry>
                <material>
                    <diffuse>1.0 1.0 1.0 1</diffuse>
                    <specular>0.08 0.08 0.08 1</specular>
                    <pbr>
                        <metal>
                            <albedo_map>materials/textures/cave_rock_albedo.jpg</albedo_map>
                            <normal_map>materials/textures/cave_rock_normal.jpg</normal_map>
                            <roughness_map>materials/textures/cave_rock_roughness.jpg</roughness_map>
                            <metalness>0.0</metalness>
                            <roughness>0.95</roughness>
                        </metal>
                    </pbr>
                </material>
            </visual>
        </link>
    </model>
</sdf>
