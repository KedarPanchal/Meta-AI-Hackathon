<?xml version='1.0'?>
<model>
  <name>Pond Water</name>
  <version>1.0</version>
  <sdf version='1.6'>model.sdf</sdf>

  <description>
    Shaded water surface, 7.5 x 5.5 m, from OpenRobotics "Coast Water" on Gazebo
    Fuel (CC BY 4.0). Visual only: it has no collision, so it is meant to be
    placed on flat ground as a pond.
  </description>
</model>
