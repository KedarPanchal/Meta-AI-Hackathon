<sdf version="1.6">
    <model name="x3">
        <pose>0 0 0.053302 0 0 0</pose>
        <link name="X3/base_link">
            <pose frame="">0 0 0 0 -0 0</pose>
            <inertial>
                <pose frame="">0 0 0 0 -0 0</pose>
                <mass>1.5</mass>
                <inertia>
                    <ixx>0.0347563</ixx>
                    <ixy>0</ixy>
                    <ixz>0</ixz>
                    <iyy>0.07</iyy>
                    <iyz>0</iyz>
                    <izz>0.0977</izz>
                </inertia>
            </inertial>
            <collision name="X3/base_link_inertia_collision">
                <pose frame="">0 0 0 0 -0 0</pose>
                <geometry>
                    <box>
                        <size>0.47 0.47 0.11</size>
                    </box>
                </geometry>
            </collision>
            <visual name="X3/base_link_inertia_visual">
                <pose frame="">0 0 0 0 -0 0</pose>
                <geometry>
                    <mesh>
                        <scale>1 1 1</scale>
                        <uri>model://x3_uav/meshes/x3.dae</uri>
                    </mesh>
                </geometry>
            </visual>

            <!-- Forward camera. Field of view, 640x480 image and pinhole
                 intrinsics are taken from the OpenRobotics "X3 UAV Config 5"
                 model on Fuel (its camera_front sensor):
                     fx = fy = width / (2 tan(hfov / 2)) = 554.3
                     cx = (width + 1) / 2  = 320.5,  cy = (height + 1) / 2 = 240.5
                 cx/cy are that model's half-pixel-shifted principal point, not
                 the exact geometric centre (320.0 / 240.0).
                 Deviations from Config 5: plain camera here (Config 5 uses
                 rgbd_camera; no depth image is published) and an explicit
                 <topic> so the stream is easy to find.

                 Pose: the optical origin sits at x = 0.25 m, i.e. clear of both
                 the 0.47 m collision box (front face at x = 0.235) and the
                 rendered x3.dae mesh (measured vertex bounds x in
                 [-0.237, 0.241], y in [-0.143, 0.156], z in [-0.053, 0.066]),
                 so no airframe geometry can occlude the view. No separate
                 camera housing is modelled; any future housing should leave the
                 optical origin and viewing frustrum unobstructed. -->
            <sensor name="camera_front" type="camera">
                <pose>0.25 0 0 0 0 0</pose>
                <topic>/X3/camera_front/image</topic>
                <always_on>1</always_on>
                <update_rate>20</update_rate>
                <camera name="camera_front">
                    <horizontal_fov>1.0472</horizontal_fov>
                    <lens>
                        <intrinsics>
                            <fx>554.3</fx>
                            <fy>554.3</fy>
                            <cx>320.5</cx>
                            <cy>240.5</cy>
                            <s>0</s>
                        </intrinsics>
                    </lens>
                    <distortion>
                        <k1>0.0</k1>
                        <k2>0.0</k2>
                        <k3>0.0</k3>
                        <p1>0.0</p1>
                        <p2>0.0</p2>
                        <center>0.5 0.5</center>
                    </distortion>
                    <image>
                        <width>640</width>
                        <height>480</height>
                        <format>R8G8B8</format>
                    </image>
                    <clip>
                        <near>0.02</near>
                        <far>300</far>
                    </clip>
                    <noise>
                        <type>gaussian</type>
                        <mean>0</mean>
                        <stddev>0.007</stddev>
                    </noise>
                </camera>
            </sensor>

            <!-- Chase camera for recording the flight. Like the GUI's follow
                 camera, it sits behind and above the airframe and looks at it:
                 the optical origin is 3 m behind and 1.5 m above the model,
                 pitched down atan2(1.5, 3) = 0.4636 rad so the drone sits in the
                 centre of the frame. Closer than the GUI's (-6, 0, 3) offset so
                 the airframe stays legible. 320x240 at 10 Hz is deliberate:
                 with the forest GUI running, a 640x480 camera at 20 Hz leaves
                 too little render budget and the recording bridge starves.
                 Server-side, so the video needs no window or screen recorder. -->
            <sensor name="camera_chase" type="camera">
                <pose>-3 0 1.5 0 0.463648 0</pose>
                <topic>/X3/camera_chase/image</topic>
                <always_on>1</always_on>
                <update_rate>10</update_rate>
                <camera name="camera_chase">
                    <horizontal_fov>1.0472</horizontal_fov>
                    <image>
                        <width>320</width>
                        <height>240</height>
                        <format>R8G8B8</format>
                    </image>
                    <clip>
                        <near>0.1</near>
                        <far>300</far>
                    </clip>
                </camera>
            </sensor>

            <!-- HD chase camera: the same framing as camera_chase, at
                 1920x1080 and 60 Hz, existing only to be recorded. The
                 CameraVideoRecorder system attached to it encodes in the
                 Gazebo server when the record_hd_video node calls its
                 service (/camera_chase_hd/record_video); see
                 fly_bringup's hd_recording launch argument. No ROS bridge
                 carries this image, so the 60 Hz stream costs render time
                 but no bridge bandwidth. That render cost is paid whenever
                 Gazebo runs, recording or not, so expect a lower
                 real-time factor than with the 320x240 chase alone. No
                 noise: the recording should be clean, and sensor noise
                 only costs encoder bitrate. -->
            <sensor name="camera_chase_hd" type="camera">
                <pose>-3 0 1.5 0 0.463648 0</pose>
                <topic>/X3/camera_chase_hd/image</topic>
                <always_on>1</always_on>
                <update_rate>60</update_rate>
                <visualize>false</visualize>
                <camera name="camera_chase_hd">
                    <horizontal_fov>1.0472</horizontal_fov>
                    <image>
                        <width>1920</width>
                        <height>1080</height>
                        <format>R8G8B8</format>
                    </image>
                    <clip>
                        <near>0.1</near>
                        <far>300</far>
                    </clip>
                </camera>
                <plugin
                    filename="gz-sim-camera-video-recorder-system"
                    name="gz::sim::systems::CameraVideoRecorder">
                    <service>/camera_chase_hd/record_video</service>
                    <bitrate>20000000</bitrate>
                    <fps>60</fps>
                    <!-- Sim-time timestamps, deliberately: with wall-clock
                         stamps a world rendering slower than real time
                         produces a 60 fps file full of duplicated frames
                         (steppy, laggy motion). Sim time maps one sensor
                         frame to one video frame, so playback is at true
                         simulation speed however long rendering took. -->
                    <use_sim_time>true</use_sim_time>
                </plugin>
            </sensor>

            <!-- Downward camera: the mission layer's eye (mcp-server, bridged to
                 /drone/camera_down_image). Pitched +90 degrees so it looks along -z: image
                 top is the drone's forward, image right is the drone's right, which is what
                 mcp-server/mission/camera.py assumes when it turns a detection into a ground
                 position. 80 degree HFOV matches CAMERA_DOWN_HFOV_DEG. 5 Hz is plenty: the
                 mission samples a frame every few metres of travel, and every extra
                 640x480 frame of forest costs the software renderer real-time factor. -->
            <sensor name="camera_down" type="camera">
                <pose>0 0 -0.03 0 1.5708 0</pose>
                <topic>/X3/camera_down/image</topic>
                <always_on>1</always_on>
                <update_rate>5</update_rate>
                <visualize>false</visualize>
                <camera name="camera_down">
                    <horizontal_fov>1.3963</horizontal_fov>
                    <image>
                        <width>640</width>
                        <height>480</height>
                        <format>R8G8B8</format>
                    </image>
                    <clip>
                        <near>0.05</near>
                        <far>300</far>
                    </clip>
                </camera>
            </sensor>

            <!-- 3-D lidar for the brain's loom reflex (fly_drone/lidar.py, bridged to
                 /drone/lidar3d_pointcloud). 32 planes over +-30 degrees of elevation at
                 10 Hz: a multirotor pitches 10 degrees nose-down to cruise, which puts the
                 single-plane scan below anything at its own level, so the reflex needs
                 vertical coverage. 320 beams per plane (1.1 degrees) is enough to see a
                 0.5 m object at 20 m as several returns. Under the airframe so the rotor
                 discs are out of its field; nothing else in the model reaches this low. -->
            <sensor name="lidar_3d" type="gpu_lidar">
                <pose>0 0 -0.08 0 0 0</pose>
                <topic>/X3/lidar_3d/scan</topic>
                <always_on>1</always_on>
                <update_rate>10</update_rate>
                <visualize>false</visualize>
                <lidar>
                    <scan>
                        <horizontal>
                            <samples>320</samples>
                            <resolution>1</resolution>
                            <min_angle>-3.141592654</min_angle>
                            <max_angle>3.141592654</max_angle>
                        </horizontal>
                        <vertical>
                            <samples>32</samples>
                            <resolution>1</resolution>
                            <min_angle>-0.5236</min_angle>
                            <max_angle>0.5236</max_angle>
                        </vertical>
                    </scan>
                    <range>
                        <!-- 0.6 m: the upper planes otherwise range on the rotor discs
                             (0.3 m out, 0.1 m up), which came back as four permanent
                             "objects" at 0.3 m. -->
                        <min>0.60</min>
                        <max>30.0</max>
                        <resolution>0.01</resolution>
                    </range>
                    <noise>
                        <type>gaussian</type>
                        <mean>0</mean>
                        <stddev>0.01</stddev>
                    </noise>
                </lidar>
            </sensor>

            <!-- 360 degree single-plane scanning lidar on top of the airframe,
                 horizontal so it sweeps the trunks and rocks around the drone.
                 Same gpu_lidar sensor type and <lidar><scan> block as the
                 gz-sim 10 examples/worlds/gpu_lidar_sensor.sdf. Not the same
                 sensor as Config 5, which carries two single-ray gpu_ray
                 rangers (top_laser / bottom_laser) that only measure height.

                 Pose: the beam plane is at z = 0.10 m, 34 mm above the highest
                 point of the rendered x3.dae mesh (z = 0.066) and 45 mm above
                 the 0.11 m collision box, so the rotating scan clears the
                 airframe and the prop discs (z ~ 0.023) instead of ranging on
                 its own body. -->
            <sensor name="lidar" type="gpu_lidar">
                <pose>0 0 0.10 0 0 0</pose>
                <topic>/X3/lidar/scan</topic>
                <always_on>1</always_on>
                <update_rate>10</update_rate>
                <lidar>
                    <scan>
                        <horizontal>
                            <samples>640</samples>
                            <resolution>1</resolution>
                            <min_angle>-3.141592654</min_angle>
                            <max_angle>3.141592654</max_angle>
                        </horizontal>
                        <vertical>
                            <samples>1</samples>
                            <resolution>1</resolution>
                            <min_angle>0</min_angle>
                            <max_angle>0</max_angle>
                        </vertical>
                    </scan>
                    <range>
                        <min>0.10</min>
                        <max>30.0</max>
                        <resolution>0.01</resolution>
                    </range>
                    <noise>
                        <type>gaussian</type>
                        <mean>0</mean>
                        <stddev>0.01</stddev>
                    </noise>
                </lidar>
            </sensor>
        </link>
        <link name="X3/rotor_0">
