<?xml version="1.0" ?>
<sdf version="1.6">
    <!-- Cubicle partition: 1.6 m wide by 1.45 m high fabric panel with an alloy
         cap rail and two feet. Long axis is x; rotate by pi/2 to run it along y
         and divide a desk row. -->
    <model name="office_partition">
        <static>true</static>
        <link name="link">
            <collision name="panel_collision">
                <pose>0 0 0.78 0 0 0</pose>
                <geometry><box><size>1.60 0.06 1.45</size></box></geometry>
            </collision>
            <visual name="panel">
                <pose>0 0 0.78 0 0 0</pose>
                <geometry><box><size>1.60 0.06 1.45</size></box></geometry>
                <material><diffuse>0.30 0.35 0.37 1</diffuse><specular>0.06 0.06 0.06 1</specular></material>
            </visual>
            <visual name="cap_rail">
                <pose>0 0 1.53 0 0 0</pose>
                <geometry><box><size>1.64 0.10 0.05</size></box></geometry>
                <material><diffuse>0.55 0.56 0.58 1</diffuse><specular>0.35 0.35 0.35 1</specular></material>
            </visual>
            <visual name="foot_left">
                <pose>-0.70 0 0.022 0 0 0</pose>
                <geometry><box><size>0.10 0.50 0.04</size></box></geometry>
                <material><diffuse>0.24 0.25 0.26 1</diffuse><specular>0.25 0.25 0.25 1</specular></material>
            </visual>
            <visual name="foot_right">
                <pose>0.70 0 0.022 0 0 0</pose>
                <geometry><box><size>0.10 0.50 0.04</size></box></geometry>
                <material><diffuse>0.24 0.25 0.26 1</diffuse><specular>0.25 0.25 0.25 1</specular></material>
            </visual>
        </link>
    </model>
</sdf>
