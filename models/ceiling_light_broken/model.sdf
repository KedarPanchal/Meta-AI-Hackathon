<?xml version="1.0" ?>
<sdf version="1.6">
    <!-- Dead ceiling fixture: the same housing as ceiling_light, but the diffuser
         is gone, one tube is shattered and the other has dropped out of its clips
         and hangs by one end. No emissive anywhere, and the world gives it no
         light, so it reads as a dark hole in the ceiling. -->
    <model name="ceiling_light_broken">
        <static>true</static>
        <link name="link">
            <visual name="rod_left">
                <pose>-0.40 0 -0.10 0 0.18 0</pose>
                <geometry><cylinder><radius>0.012</radius><length>0.14</length></cylinder></geometry>
                <material><diffuse>0.30 0.30 0.31 1</diffuse><specular>0.2 0.2 0.2 1</specular></material>
            </visual>
            <visual name="rod_right">
                <pose>0.40 0 -0.07 0 0 0</pose>
                <geometry><cylinder><radius>0.012</radius><length>0.14</length></cylinder></geometry>
                <material><diffuse>0.30 0.30 0.31 1</diffuse><specular>0.2 0.2 0.2 1</specular></material>
            </visual>
            <collision name="housing_collision">
                <pose>0 0 -0.19 0 0.06 0</pose>
                <geometry><box><size>1.22 0.32 0.08</size></box></geometry>
            </collision>
            <visual name="housing">
                <pose>0 0 -0.19 0 0.06 0</pose>
                <geometry><box><size>1.22 0.32 0.08</size></box></geometry>
                <material><diffuse>0.30 0.30 0.31 1</diffuse><specular>0.25 0.25 0.25 1</specular></material>
            </visual>
            <!-- Tube still clipped at one end, hanging down and across. -->
            <visual name="hanging_tube">
                <pose>-0.28 -0.07 -0.42 0 1.05 0.10</pose>
                <geometry><box><size>1.00 0.09 0.035</size></box></geometry>
                <material><diffuse>0.55 0.55 0.56 1</diffuse><specular>0.2 0.2 0.2 1</specular></material>
            </visual>
            <!-- Shattered stub left in the other clip. -->
            <visual name="tube_stub">
                <pose>0.42 0.07 -0.25 0 0 0</pose>
                <geometry><box><size>0.22 0.09 0.035</size></box></geometry>
                <material><diffuse>0.48 0.48 0.49 1</diffuse><specular>0.2 0.2 0.2 1</specular></material>
            </visual>
            <visual name="glass_shard">
                <pose>0.30 0.05 -0.30 0.4 0.3 0.7</pose>
                <geometry><box><size>0.18 0.05 0.012</size></box></geometry>
                <material><diffuse>0.70 0.72 0.74 1</diffuse><specular>0.6 0.6 0.6 1</specular></material>
            </visual>
        </link>
    </model>
</sdf>
