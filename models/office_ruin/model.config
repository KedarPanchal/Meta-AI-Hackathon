<?xml version="1.0"?>

<model>
  <name>Office Ruin</name>
  <version>1.0</version>
  <sdf version="1.6">model.sdf</sdf>

  <description>
    One floor of a collapsed office building, 24 x 18 m inside: floor and roof
    slabs, perimeter walls with the north-east corner torn open, eight columns
    (one sheared off), a snapped internal wall and a roof slab hanging into the
    collapse zone. Primitive geometry, static, one link.
  </description>
</model>
