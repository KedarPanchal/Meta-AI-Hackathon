<?xml version="1.0" ?>
<sdf version="1.6">
    <!-- Wall whiteboard, 1.8 x 1.1 m, alloy frame and a marker tray. Panel faces
         -y, origin on the floor at the wall, so a board on the north wall gets
         yaw pi and one on the south wall gets yaw 0. -->
    <model name="office_whiteboard">
        <static>true</static>
        <link name="link">
            <collision name="panel_collision">
                <pose>0 0 1.55 0 0 0</pose>
                <geometry><box><size>1.80 0.05 1.10</size></box></geometry>
            </collision>
            <visual name="panel">
                <pose>0 0 1.55 0 0 0</pose>
                <geometry><box><size>1.80 0.05 1.10</size></box></geometry>
                <material><diffuse>0.88 0.89 0.88 1</diffuse><specular>0.25 0.25 0.25 1</specular></material>
            </visual>
            <visual name="frame_top">
                <pose>0 0 2.13 0 0 0</pose>
                <geometry><box><size>1.88 0.07 0.06</size></box></geometry>
                <material><diffuse>0.55 0.56 0.58 1</diffuse><specular>0.35 0.35 0.35 1</specular></material>
            </visual>
            <visual name="frame_bottom">
                <pose>0 0 0.97 0 0 0</pose>
                <geometry><box><size>1.88 0.07 0.06</size></box></geometry>
                <material><diffuse>0.55 0.56 0.58 1</diffuse><specular>0.35 0.35 0.35 1</specular></material>
            </visual>
            <visual name="frame_left">
                <pose>-0.91 0 1.55 0 0 0</pose>
                <geometry><box><size>0.06 0.07 1.22</size></box></geometry>
                <material><diffuse>0.55 0.56 0.58 1</diffuse><specular>0.35 0.35 0.35 1</specular></material>
            </visual>
            <visual name="frame_right">
                <pose>0.91 0 1.55 0 0 0</pose>
                <geometry><box><size>0.06 0.07 1.22</size></box></geometry>
                <material><diffuse>0.55 0.56 0.58 1</diffuse><specular>0.35 0.35 0.35 1</specular></material>
            </visual>
            <visual name="tray">
                <pose>0 -0.08 0.94 0 0 0</pose>
                <geometry><box><size>1.70 0.10 0.03</size></box></geometry>
                <material><diffuse>0.55 0.56 0.58 1</diffuse><specular>0.35 0.35 0.35 1</specular></material>
            </visual>
        </link>
    </model>
</sdf>
