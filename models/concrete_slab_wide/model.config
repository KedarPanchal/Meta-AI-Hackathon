<?xml version="1.0"?>

<model>
  <name>Concrete Slab (wide)</name>
  <version>1.0</version>
  <sdf version="1.6">model.sdf</sdf>

  <description>
    Wide broken concrete floor slab, 2.70 x 1.45 x 0.22 m, with the -x/-y corner
