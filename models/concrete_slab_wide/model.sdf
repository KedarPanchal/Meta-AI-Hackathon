<?xml version="1.0" ?>
<sdf version="1.6">
    <!-- Wide broken floor slab, 2.70 x 1.45 m and 0.22 m thick, with the -x/-y
         corner broken off and five lengths of rebar torn out of the +x edge.
         Geometry and textures are generated by
         models/concrete_slab/generate_slab_mesh.py (variant
         concrete_slab_wide); one mesh serves as visual and collision.

         Origin is at the middle of the slab, so place it at rubble height. -->
    <model name="concrete_slab_wide">
        <static>true</static>
        <link name="link">
            <collision name="collision">
                <geometry>
                    <mesh>
                        <uri>meshes/concrete_slab_wide.dae</uri>
                    </mesh>
                </geometry>
                <surface>
                    <friction>
                        <ode>
                            <mu>1.0</mu>
                            <mu2>1.0</mu2>
                        </ode>
                    </friction>
                </surface>
            </collision>
            <visual name="visual">
                <geometry>
                    <mesh>
                        <uri>meshes/concrete_slab_wide.dae</uri>
                    </mesh>
                </geometry>
                <material>
                    <diffuse>1.0 1.0 1.0 1</diffuse>
                    <specular>0.04 0.04 0.04 1</specular>
                    <pbr>
                        <metal>
                            <albedo_map>materials/textures/concrete_albedo.png</albedo_map>
                            <normal_map>materials/textures/concrete_normal.png</normal_map>
                            <metalness>0.0</metalness>
                            <roughness>0.92</roughness>
                        </metal>
                    </pbr>
                </material>
            </visual>

            <!-- Rebar torn out of the broken edge. -->
            <visual name="rebar_1">
                <pose>1.30 -0.55 0.01 0 1.5708 0.05</pose>
                <geometry><cylinder><radius>0.012</radius><length>0.66</length></cylinder></geometry>
                <material><diffuse>0.33 0.21 0.14 1</diffuse><specular>0.3 0.3 0.3 1</specular></material>
            </visual>
            <visual name="rebar_2">
                <pose>1.28 -0.28 -0.02 0 1.5200 -0.04</pose>
                <geometry><cylinder><radius>0.012</radius><length>0.58</length></cylinder></geometry>
                <material><diffuse>0.33 0.21 0.14 1</diffuse><specular>0.3 0.3 0.3 1</specular></material>
            </visual>
            <visual name="rebar_3">
                <pose>1.30 0.02 0.02 0 1.6100 0.09</pose>
                <geometry><cylinder><radius>0.012</radius><length>0.62</length></cylinder></geometry>
                <material><diffuse>0.33 0.21 0.14 1</diffuse><specular>0.3 0.3 0.3 1</specular></material>
            </visual>
            <visual name="rebar_4">
                <pose>1.29 0.30 -0.01 0 1.4900 0.02</pose>
                <geometry><cylinder><radius>0.012</radius><length>0.55</length></cylinder></geometry>
                <material><diffuse>0.33 0.21 0.14 1</diffuse><specular>0.3 0.3 0.3 1</specular></material>
            </visual>
            <visual name="rebar_5">
                <pose>1.27 0.56 0.00 0 1.5800 -0.07</pose>
                <geometry><cylinder><radius>0.012</radius><length>0.48</length></cylinder></geometry>
                <material><diffuse>0.33 0.21 0.14 1</diffuse><specular>0.3 0.3 0.3 1</specular></material>
            </visual>
        </link>
    </model>
</sdf>
