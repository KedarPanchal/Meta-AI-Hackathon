<?xml version="1.0" ?>
<sdf version="1.6">
    <!-- Dirt forest floor. The dirt/leaf-litter texture comes from
         https://fuel.gazebosim.org/1.0/OpenRobotics/models/Mud%20Box
         (CC BY 4.0, OpenRobotics). The ground is a 40 x 40 m quad mesh whose
         UVs repeat 10 x 10 times so the texture tiles rather than stretching. -->
    <model name="forest_ground">
        <static>true</static>
        <link name="link">
            <collision name="collision">
                <geometry>
                    <plane>
                        <normal>0 0 1</normal>
                        <size>40 40</size>
                    </plane>
                </geometry>
                <surface>
                    <friction>
                        <ode>
                            <mu>1.0</mu>
                            <mu2>1.0</mu2>
                        </ode>
                    </friction>
                </surface>
            </collision>
            <visual name="visual">
                <geometry>
                    <mesh>
                        <uri>meshes/ground.dae</uri>
                    </mesh>
                </geometry>
                <material>
                    <pbr>
                        <metal>
                            <albedo_map>materials/textures/mud_soft_leaves.png</albedo_map>
                            <roughness>0.95</roughness>
                            <metalness>0.0</metalness>
                        </metal>
                    </pbr>
                </material>
            </visual>
        </link>
    </model>
</sdf>
