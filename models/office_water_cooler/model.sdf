<?xml version="1.0" ?>
<sdf version="1.6">
    <!-- Office water cooler: 0.36 m square body, clear bottle on top and two
         taps on the -y face. -->
    <model name="office_water_cooler">
        <static>true</static>
        <link name="link">
            <collision name="body_collision">
                <pose>0 0 0.47 0 0 0</pose>
                <geometry><box><size>0.36 0.36 0.94</size></box></geometry>
            </collision>
            <visual name="body">
                <pose>0 0 0.47 0 0 0</pose>
                <geometry><box><size>0.36 0.36 0.94</size></box></geometry>
                <material><diffuse>0.72 0.73 0.74 1</diffuse><specular>0.2 0.2 0.2 1</specular></material>
            </visual>
            <visual name="bottle">
                <pose>0 0 1.16 0 0 0</pose>
                <geometry><cylinder><radius>0.15</radius><length>0.44</length></cylinder></geometry>
                <material>
                    <diffuse>0.55 0.72 0.82 1</diffuse>
                    <specular>0.5 0.5 0.5 1</specular>
                </material>
            </visual>
            <visual name="tap_cold">
                <pose>-0.07 -0.19 0.86 0 0 0</pose>
                <geometry><box><size>0.05 0.04 0.05</size></box></geometry>
                <material><diffuse>0.25 0.35 0.55 1</diffuse><specular>0.4 0.4 0.4 1</specular></material>
            </visual>
            <visual name="tap_hot">
                <pose>0.07 -0.19 0.86 0 0 0</pose>
                <geometry><box><size>0.05 0.04 0.05</size></box></geometry>
                <material><diffuse>0.55 0.25 0.22 1</diffuse><specular>0.4 0.4 0.4 1</specular></material>
            </visual>
            <visual name="drip_tray">
                <pose>0 -0.19 0.74 0 0 0</pose>
                <geometry><box><size>0.26 0.05 0.02</size></box></geometry>
                <material><diffuse>0.55 0.56 0.58 1</diffuse></material>
            </visual>
        </link>
    </model>
</sdf>
