<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="forest_search">
    <gravity>0 0 -9.81</gravity>
    <magnetic_field>6.0e-06 2.3e-05 -4.2e-05</magnetic_field>

    <!-- Late-morning sun: about 56 degrees above the horizon, warm daylight.
         The direction is a unit vector pointing from the sun towards the scene. -->
    <light name="sun" type="directional">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 15 0 0 0</pose>
      <diffuse>1.0 0.95 0.85 1</diffuse>
      <specular>0.3 0.3 0.3 1</specular>
      <direction>-0.45 0.32 -0.83</direction>
    </light>
    <!-- Cool skylight fill from the opposite side of the sky. This lifts the
         shadowed sides of the trees and rocks so the forest is not so dark. -->
    <light name="sky_fill" type="directional">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.3 0.36 0.46 1</diffuse>
      <specular>0 0 0 1</specular>
      <direction>0.4 -0.3 -0.86</direction>
    </light>
    <scene>
      <ambient>0.45 0.47 0.5 1</ambient>
      <background>0.6 0.76 0.93 1</background>
      <shadows>true</shadows>
    </scene>
    <physics name="default_physics" type="ode">
      <max_step_size>0.004</max_step_size>
      <real_time_update_rate>250</real_time_update_rate>
    </physics>

    <!-- Dirt forest floor, textured with a Fuel ground texture. -->
    <include>
      <uri>model://forest_ground</uri>
      <name>forest_floor</name>
    </include>

    <include>
      <uri>model://x3_uav</uri>
      <name>x3_search_uav</name>
      <pose>-9 -7 2.8 0 0 0</pose>
    </include>

    <!-- Scattered conifers create multiple search lanes and conceal the target. -->
    <include><uri>model://pine_tree</uri><name>pine_01</name><pose>-15 -13 0 0 0 0.2</pose></include>
    <include><uri>model://pine_tree</uri><name>pine_02</name><pose>-9 -14 0 0 0 -0.7</pose></include>
    <include><uri>model://pine_tree</uri><name>pine_03</name><pose>-2 -14 0 0 0 0.5</pose></include>
    <include><uri>model://pine_tree</uri><name>pine_04</name><pose>7 -14 0 0 0 -0.3</pose></include>
    <include><uri>model://pine_tree</uri><name>pine_05</name><pose>15 -12 0 0 0 0.8</pose></include>
    <include><uri>model://pine_tree</uri><name>pine_06</name><pose>-15 -6 0 0 0 -0.2</pose></include>
    <include><uri>model://pine_tree</uri><name>pine_07</name><pose>-10 -3 0 0 0 0.9</pose></include>
    <include><uri>model://pine_tree</uri><name>pine_08</name><pose>-2 -6 0 0 0 -0.4</pose></include>
    <include><uri>model://pine_tree</uri><name>pine_09</name><pose>3 -3 0 0 0 0.7</pose></include>
    <include><uri>model://pine_tree</uri><name>pine_10</name><pose>11 -6 0 0 0 -0.8</pose></include>
    <include><uri>model://pine_tree</uri><name>pine_11</name><pose>16 -4 0 0 0 0.1</pose></include>
    <include><uri>model://pine_tree</uri><name>pine_12</name><pose>-15 4 0 0 0 0.4</pose></include>
    <include><uri>model://pine_tree</uri><name>pine_13</name><pose>-10 7 0 0 0 -0.5</pose></include>
    <include><uri>model://pine_tree</uri><name>pine_14</name><pose>-4 5 0 0 0 0.2</pose></include>
    <include><uri>model://pine_tree</uri><name>pine_15</name><pose>2 8 0 0 0 -0.9</pose></include>
    <include><uri>model://pine_tree</uri><name>pine_16</name><pose>9 6 0 0 0 0.6</pose></include>
    <include><uri>model://pine_tree</uri><name>pine_17</name><pose>15 8 0 0 0 -0.1</pose></include>
    <include><uri>model://pine_tree</uri><name>pine_18</name><pose>-14 14 0 0 0 -0.3</pose></include>
    <include><uri>model://pine_tree</uri><name>pine_19</name><pose>-6 14 0 0 0 0.8</pose></include>
    <include><uri>model://pine_tree</uri><name>pine_20</name><pose>2 14 0 0 0 -0.6</pose></include>
    <include><uri>model://pine_tree</uri><name>pine_21</name><pose>10 14 0 0 0 0.3</pose></include>
    <include><uri>model://pine_tree</uri><name>pine_22</name><pose>16 13 0 0 0 -0.8</pose></include>

    <!-- Shaded pond in the north-east clearing, ringed by boulders. -->
    <include>
      <uri>model://pond_water</uri>
      <name>pond</name>
      <pose>10.5 -10.5 0.03 0 0 0</pose>
    </include>
    <include><uri>model://rock_03</uri><name>shore_rock_01</name><pose>6.6 -8.9 0.32 0 0 0.4</pose><static>true</static></include>
    <include><uri>model://rock_02</uri><name>shore_rock_02</name><pose>7.4 -13.45 0.225 0 0 -0.7</pose><static>true</static></include>
    <include><uri>model://rock_03</uri><name>shore_rock_03</name><pose>10.4 -13.4 0.32 0 0 1.2</pose><static>true</static></include>
    <include><uri>model://rock_02</uri><name>shore_rock_04</name><pose>13.0 -13.35 0.225 0 0 2.0</pose><static>true</static></include>
    <include><uri>model://rock_01</uri><name>shore_rock_05</name><pose>14.6 -10.8 0.55 0 0 -0.3</pose><static>true</static></include>
    <include><uri>model://rock_02</uri><name>shore_rock_06</name><pose>14.4 -8.7 0.225 0 0 0.8</pose><static>true</static></include>
    <include><uri>model://rock_03</uri><name>shore_rock_07</name><pose>12.0 -7.55 0.32 0 0 -0.9</pose><static>true</static></include>
    <include><uri>model://rock_02</uri><name>shore_rock_08</name><pose>8.7 -7.6 0.225 0 0 0.2</pose><static>true</static></include>

    <!-- Boulders scattered through the forest give the drone more cover to search around. -->
    <include><uri>model://rock_01</uri><name>rock_west</name><pose>-6.0 0.6 0.55 0 0 0.6</pose><static>true</static></include>
    <include><uri>model://rock_03</uri><name>rock_east</name><pose>13.2 2.6 0.32 0 0 -0.4</pose><static>true</static></include>
    <include><uri>model://rock_01</uri><name>rock_north_west</name><pose>-11.3 9.6 0.55 0 0 1.2</pose><static>true</static></include>
    <include><uri>model://rock_03</uri><name>rock_south</name><pose>-1.2 -10.8 0.32 0 0 0.3</pose><static>true</static></include>
    <include><uri>model://rock_02</uri><name>rock_east_lane</name><pose>12.4 -2.6 0.225 0 0 -0.8</pose><static>true</static></include>
    <include><uri>model://rock_03</uri><name>rock_north</name><pose>7.6 11.4 0.32 0 0 0.9</pose><static>true</static></include>
    <include><uri>model://rock_01</uri><name>rock_south_lane</name><pose>1.8 -11.6 0.55 0 0 2.4</pose><static>true</static></include>

    <!-- The target lies on its side beneath nearby trees rather than in the open. -->
    <include>
      <uri>model://person_standing</uri>
      <name>person_target</name>
      <pose>5.0 3.2 0.04 0 1.5708 0.35</pose>
    </include>
    <include><uri>model://pine_tree</uri><name>target_tree_west</name><pose>2.7 2.1 0 0 0 0.4</pose></include>
    <include><uri>model://pine_tree</uri><name>target_tree_north</name><pose>5.2 6.3 0 0 0 -0.5</pose></include>
    <include><uri>model://pine_tree</uri><name>target_tree_east</name><pose>8.5 3.5 0 0 0 0.8</pose></include>
    <include><uri>model://pine_tree</uri><name>target_tree_south</name><pose>5.8 0.3 0 0 0 -0.2</pose></include>
  </world>
</sdf>
