    <include><uri>model://pine_tree</uri><name>pine_outer_319</name><pose>15.45 56.06 0 0 0 -2.98</pose></include>
    <include><uri>model://pine_tree</uri><name>pine_outer_320</name><pose>-40.59 56.12 0 0 0 1.72</pose></include>

    <!-- Shaded pond in the north-east clearing, ringed by boulders. The water
         surface has an irregular outline rather than a rectangular edge. -->
    <include>
      <uri>model://pond_water</uri>
      <name>pond</name>
      <pose>10.5 -10.5 0.03 0 0 0</pose>
    </include>
    <include><uri>model://rock_03</uri><name>shore_rock_01</name><pose>6.6 -8.9 0.32 0 0 0.4</pose><static>true</static></include>
    <include><uri>model://rock_02</uri><name>shore_rock_02</name><pose>7.4 -13.45 0.225 0 0 -0.7</pose><static>true</static></include>
    <include><uri>model://rock_03</uri><name>shore_rock_03</name><pose>10.4 -13.4 0.32 0 0 1.2</pose><static>true</static></include>
    <include><uri>model://rock_02</uri><name>shore_rock_04</name><pose>13.0 -13.35 0.225 0 0 2.0</pose><static>true</static></include>
    <include><uri>model://rock_01</uri><name>shore_rock_05</name><pose>14.6 -10.8 0.55 0 0 -0.3</pose><static>true</static></include>
    <include><uri>model://rock_02</uri><name>shore_rock_06</name><pose>14.4 -8.7 0.225 0 0 0.8</pose><static>true</static></include>
    <include><uri>model://rock_03</uri><name>shore_rock_07</name><pose>12.0 -7.55 0.32 0 0 -0.9</pose><static>true</static></include>
    <include><uri>model://rock_02</uri><name>shore_rock_08</name><pose>8.7 -7.6 0.225 0 0 0.2</pose><static>true</static></include>

    <!-- Abandoned campsite in the south-west clearing: a field canopy, a picnic
         table and a log dragged up beside it. The target is not here, so this is
         a landmark to navigate by and to rule out. -->
    <include>
      <uri>model://tent</uri>
      <name>camp_tent</name>
      <pose>-7.0 -10.4 0 0 0 0.35</pose>
    </include>
    <include>
      <uri>model://picnic_table</uri>
      <name>camp_table</name>
      <pose>-4.2 -8.8 -0.015 0 0 -0.3</pose>
    </include>

    <!-- Fallen logs, each lying where a pine came down: two around the campsite
         and two out in the search lanes. -->
    <include><uri>model://fallen_log</uri><name>fallen_log_camp</name><pose>-5.9 -12.9 0 0 0 0.1</pose></include>
    <include><uri>model://fallen_log</uri><name>fallen_log_west</name><pose>-11.6 -11.0 0 0 0 1.1</pose></include>
    <include><uri>model://fallen_log</uri><name>fallen_log_centre</name><pose>-6.6 -3.2 0 0 0 1.35</pose></include>
    <include><uri>model://fallen_log</uri><name>fallen_log_east</name><pose>12.4 9.0 0 0 0 0.9</pose></include>

    <!-- Coloured landmarks of different heights, placed in the clearings: a
         fire-lookout tower that stands well above the 5 m pines, a thinner
         red-and-white signal mast, and a low orange trail marker. -->
    <include>
      <uri>model://lookout_tower</uri>
      <name>lookout_tower</name>
      <pose>-10.0 2.0 0 0 0 0.35</pose>
    </include>
    <include>
      <uri>model://signal_mast</uri>
      <name>signal_mast</name>
      <pose>-1.5 -1.0 0 0 0 0</pose>
    </include>
    <include>
      <uri>model://trail_marker</uri>
      <name>trail_marker</name>
      <pose>-3.0 11.5 0 0 0 -0.4</pose>
    </include>

    <!-- Boulders scattered through the forest give the drone more cover to search around.
         The scatter rocks below are smaller variants (0.39 to 1.05 m tall) of the
         same Fuel boulders, so nothing here is larger than rock_01. -->
    <include><uri>model://rock_01</uri><name>rock_west</name><pose>-6.0 0.6 0.55 0 0 0.6</pose><static>true</static></include>
    <include><uri>model://rock_03</uri><name>rock_east</name><pose>13.2 2.6 0.32 0 0 -0.4</pose><static>true</static></include>
    <include><uri>model://rock_01</uri><name>rock_north_west</name><pose>-11.3 9.6 0.55 0 0 1.2</pose><static>true</static></include>
    <include><uri>model://rock_03</uri><name>rock_south</name><pose>-1.2 -10.8 0.32 0 0 0.3</pose><static>true</static></include>
    <include><uri>model://rock_02</uri><name>rock_east_lane</name><pose>12.4 -2.6 0.225 0 0 -0.8</pose><static>true</static></include>
    <include><uri>model://rock_03</uri><name>rock_north</name><pose>7.6 11.4 0.32 0 0 0.9</pose><static>true</static></include>
    <include><uri>model://rock_01</uri><name>rock_south_lane</name><pose>1.8 -11.6 0.55 0 0 2.4</pose><static>true</static></include>
    <include><uri>model://rock_04</uri><name>rock_scatter_01</name><pose>9.13 -2.84 0.130 0 0 1.57</pose><static>true</static></include>
    <include><uri>model://rock_04</uri><name>rock_scatter_02</name><pose>-1.07 5.63 0.130 0 0 -1.67</pose><static>true</static></include>
    <include><uri>model://rock_04</uri><name>rock_scatter_03</name><pose>0.56 -8.16 0.130 0 0 -0.97</pose><static>true</static></include>
    <include><uri>model://rock_04</uri><name>rock_scatter_04</name><pose>-3.55 9.45 0.130 0 0 -0.39</pose><static>true</static></include>
    <include><uri>model://rock_05</uri><name>rock_scatter_05</name><pose>6.10 12.58 0.179 0 0 -0.42</pose><static>true</static></include>
    <include><uri>model://rock_05</uri><name>rock_scatter_06</name><pose>-14.92 10.48 0.179 0 0 -1.37</pose><static>true</static></include>
    <include><uri>model://rock_05</uri><name>rock_scatter_07</name><pose>-4.03 0.84 0.179 0 0 -2.17</pose><static>true</static></include>
    <include><uri>model://rock_06</uri><name>rock_scatter_08</name><pose>7.04 8.97 0.398 0 0 -2.98</pose><static>true</static></include>
    <include><uri>model://rock_06</uri><name>rock_scatter_09</name><pose>6.30 -4.84 0.398 0 0 2.39</pose><static>true</static></include>
    <include><uri>model://rock_02</uri><name>rock_scatter_10</name><pose>-9.32 10.47 0.225 0 0 2.99</pose><static>true</static></include>

    <!-- The target lies on its side beneath nearby trees rather than in the open.
         Z is half the body width: rolled 90 degrees onto its side, the 1.92 m
         figure is 0.54 m across, so 0.268 m puts it on the dirt instead of
         0.23 m through it. -->
    <include>
      <uri>model://person_standing</uri>
      <name>person_target</name>
      <pose>5.0 3.2 0.268 0 1.5708 0.35</pose>
    </include>
    <include><uri>model://pine_tree</uri><name>target_tree_west</name><pose>2.7 2.1 0 0 0 0.4</pose></include>
    <include><uri>model://pine_tree</uri><name>target_tree_north</name><pose>5.2 6.3 0 0 0 -0.5</pose></include>
    <include><uri>model://pine_tree</uri><name>target_tree_east</name><pose>8.5 3.5 0 0 0 0.8</pose></include>
    <include><uri>model://pine_tree</uri><name>target_tree_south</name><pose>5.8 0.3 0 0 0 -0.2</pose></include>
  </world>
</sdf>
