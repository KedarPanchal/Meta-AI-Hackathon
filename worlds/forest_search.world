<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="forest_search">
    <gravity>0 0 -9.81</gravity>
    <magnetic_field>6.0e-06 2.3e-05 -4.2e-05</magnetic_field>

    <!-- Late-morning sun: about 56 degrees above the horizon, warm daylight.
         The direction is a unit vector pointing from the sun towards the scene. -->
    <light name="sun" type="directional">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 15 0 0 0</pose>
      <diffuse>1.0 0.95 0.85 1</diffuse>
      <specular>0.3 0.3 0.3 1</specular>
      <direction>-0.45 0.32 -0.83</direction>
    </light>
    <!-- Cool skylight fill from the opposite side of the sky. This lifts the
         shadowed sides of the trees and rocks so the forest is not so dark. -->
    <light name="sky_fill" type="directional">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.3 0.36 0.46 1</diffuse>
      <specular>0 0 0 1</specular>
      <direction>0.4 -0.3 -0.86</direction>
    </light>
    <scene>
      <ambient>0.45 0.47 0.5 1</ambient>
      <background>0.6 0.76 0.93 1</background>
      <shadows>true</shadows>
    </scene>
    <physics name="default_physics" type="ode">
      <max_step_size>0.004</max_step_size>
      <real_time_update_rate>250</real_time_update_rate>
    </physics>

    <!-- Simulation systems, declared explicitly because the world defines its
         own plugin list: once any <plugin> is present the defaults from
         ~/.gz/sim/10/server.config are no longer loaded. The first three are
         those defaults (physics, model insertion, scene updates); Sensors is
         what renders the X3 camera images and lidar scans. -->
    <plugin filename="gz-sim-physics-system"
            name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system"
            name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system"
            name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system"
            name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <!-- Grassy forest floor: rolling hills and dips (about 6 m of total
         relief, mostly under 10 degrees), turf, leaf litter and twigs tiled
         in 4 m squares. Every prop below is lifted to sit on the surface. -->
    <include>
      <uri>model://forest_ground</uri>
      <name>forest_floor</name>
    </include>

    <include>
      <uri>model://x3_uav</uri>
      <name>x3_search_uav</name>
      <pose>-9 -7 2.526 0 0 0</pose>
    </include>

    <!-- Search layouts land in separate clearings across the 120 x 120 m map:
         pond on the north-east shoulder, campsite south-west behind the drone
         start, a lookout tower in each of two quadrants, a signal mast in the
         north and a radio pole in the east, all visible as navigation fixes. -->

    <!-- Shaded pond in the north-east clearing, ringed by boulders. The water
         surface has an irregular outline rather than a rectangular edge. -->
    <include>
      <uri>model://pond_water</uri>
      <name>pond</name>
      <pose>31 27 0.03 0 0 0</pose>
    </include>
    <include><uri>model://rock_03</uri><name>shore_rock_01</name><pose>27.1 28.6 0.342 0 0 0.4</pose><static>true</static></include>
    <include><uri>model://rock_02</uri><name>shore_rock_02</name><pose>27.9 24.05 0.163 0 0 -0.7</pose><static>true</static></include>
    <include><uri>model://rock_03</uri><name>shore_rock_03</name><pose>30.9 24.1 0.207 0 0 1.2</pose><static>true</static></include>
    <include><uri>model://rock_02</uri><name>shore_rock_04</name><pose>33.5 24.15 0.281 0 0 2</pose><static>true</static></include>
    <include><uri>model://rock_01</uri><name>shore_rock_05</name><pose>35.1 26.7 0.489 0 0 -0.3</pose><static>true</static></include>
    <include><uri>model://rock_02</uri><name>shore_rock_06</name><pose>34.9 28.8 0.28 0 0 0.8</pose><static>true</static></include>
    <include><uri>model://rock_03</uri><name>shore_rock_07</name><pose>32.5 29.95 0.234 0 0 -0.9</pose><static>true</static></include>
    <include><uri>model://rock_02</uri><name>shore_rock_08</name><pose>29.2 29.9 0.28 0 0 0.2</pose><static>true</static></include>

    <!-- Abandoned campsite in the south-west: a field canopy, a picnic table
         and the logs dragged up beside it. The target is elsewhere, so this is
         a landmark to navigate by and to rule out. -->
    <include>
      <uri>model://tent</uri>
      <name>camp_tent</name>
      <pose>-32 -28 0.45 0 0 0.35</pose>
    </include>
    <include>
      <uri>model://picnic_table</uri>
      <name>camp_table</name>
      <pose>-28.3 -26.3 0.44 0 0 -0.3</pose>
    </include>
    <include><uri>model://fallen_log</uri><name>fallen_log_camp</name><pose>-30.6 -32.2 0.45 0 0 0.1</pose></include>
    <include><uri>model://fallen_log</uri><name>fallen_log_west</name><pose>-36.5 -26 0.45 0 0 1.1</pose></include>
    <include><uri>model://fallen_log</uri><name>fallen_log_north</name><pose>-6 18 2.969 0 0 1.35</pose></include>
    <include><uri>model://fallen_log</uri><name>fallen_log_east</name><pose>26 -10 -2.303 0 0 0.9</pose></include>

    <!-- Coloured vertical landmarks spread through the map: two fire-lookout
         towers standing above the 5 m canopy, a red-and-white signal mast, a
         timber radio pole, and a low orange trail marker. -->
    <include>
      <uri>model://lookout_tower</uri>
      <name>lookout_tower</name>
      <pose>-34 24 1.583 0 0 0.35</pose>
    </include>
    <include>
      <uri>model://lookout_tower</uri>
      <name>lookout_tower_east</name>
      <pose>35 -30 -2.211 0 0 -0.75</pose>
    </include>
    <include>
      <uri>model://signal_mast</uri>
      <name>signal_mast</name>
      <pose>-2 42 0.439 0 0 0</pose>
    </include>
    <include>
      <uri>model://radio_pole</uri>
      <name>radio_pole</name>
      <pose>45 5 -1.032 0 0 0.3</pose>
    </include>
    <include>
      <uri>model://trail_marker</uri>
      <name>trail_marker</name>
      <pose>-46 -3 -0.352 0 0 -0.4</pose>
    </include>

    <!-- Boulders spread across the forest. Sizes stay below the largest original
         boulder (rock_01, 1.39 m tall); each is sunk 12% of its height like before. -->
    <include><uri>model://rock_01</uri><name>rock_west</name><pose>-20 -12 0.084 0 0 0.6</pose><static>true</static></include>
    <include><uri>model://rock_01</uri><name>rock_north_west</name><pose>-25 11 2.087 0 0 1.2</pose><static>true</static></include>
