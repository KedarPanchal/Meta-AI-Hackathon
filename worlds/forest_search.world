<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="forest_search">
    <gravity>0 0 -9.81</gravity>
    <magnetic_field>6.0e-06 2.3e-05 -4.2e-05</magnetic_field>

    <light name="sun" type="directional">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 15 0.35 -0.5 0</pose>
      <diffuse>0.95 0.92 0.82 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.3 0.2 -1</direction>
    </light>
    <scene>
      <ambient>0.35 0.35 0.35 1</ambient>
      <background>0.55 0.72 0.88 1</background>
      <shadows>true</shadows>
    </scene>
    <physics name="default_physics" type="ode">
      <max_step_size>0.004</max_step_size>
      <real_time_update_rate>250</real_time_update_rate>
    </physics>

    <model name="forest_floor">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>40 40</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>40 40</size></plane></geometry>
          <material><ambient>0.13 0.20 0.06 1</ambient><diffuse>0.21 0.32 0.08 1</diffuse></material>
        </visual>
      </link>
    </model>

    <include>
      <uri>model://x3_uav</uri>
      <name>x3_search_uav</name>
      <pose>-9 -7 2.8 0 0 0</pose>
    </include>

    <!-- Scattered conifers create multiple search lanes and conceal the target. -->
    <include><uri>model://pine_tree</uri><name>pine_01</name><pose>-15 -13 0 0 0 0.2</pose></include>
    <include><uri>model://pine_tree</uri><name>pine_02</name><pose>-9 -14 0 0 0 -0.7</pose></include>
    <include><uri>model://pine_tree</uri><name>pine_03</name><pose>-2 -14 0 0 0 0.5</pose></include>
    <include><uri>model://pine_tree</uri><name>pine_04</name><pose>7 -14 0 0 0 -0.3</pose></include>
    <include><uri>model://pine_tree</uri><name>pine_05</name><pose>15 -12 0 0 0 0.8</pose></include>
    <include><uri>model://pine_tree</uri><name>pine_06</name><pose>-15 -6 0 0 0 -0.2</pose></include>
    <include><uri>model://pine_tree</uri><name>pine_07</name><pose>-10 -3 0 0 0 0.9</pose></include>
    <include><uri>model://pine_tree</uri><name>pine_08</name><pose>-2 -6 0 0 0 -0.4</pose></include>
    <include><uri>model://pine_tree</uri><name>pine_09</name><pose>3 -3 0 0 0 0.7</pose></include>
    <include><uri>model://pine_tree</uri><name>pine_10</name><pose>11 -6 0 0 0 -0.8</pose></include>
    <include><uri>model://pine_tree</uri><name>pine_11</name><pose>16 -4 0 0 0 0.1</pose></include>
    <include><uri>model://pine_tree</uri><name>pine_12</name><pose>-15 4 0 0 0 0.4</pose></include>
    <include><uri>model://pine_tree</uri><name>pine_13</name><pose>-10 7 0 0 0 -0.5</pose></include>
    <include><uri>model://pine_tree</uri><name>pine_14</name><pose>-4 5 0 0 0 0.2</pose></include>
    <include><uri>model://pine_tree</uri><name>pine_15</name><pose>2 8 0 0 0 -0.9</pose></include>
    <include><uri>model://pine_tree</uri><name>pine_16</name><pose>9 6 0 0 0 0.6</pose></include>
    <include><uri>model://pine_tree</uri><name>pine_17</name><pose>15 8 0 0 0 -0.1</pose></include>
    <include><uri>model://pine_tree</uri><name>pine_18</name><pose>-14 14 0 0 0 -0.3</pose></include>
    <include><uri>model://pine_tree</uri><name>pine_19</name><pose>-6 14 0 0 0 0.8</pose></include>
    <include><uri>model://pine_tree</uri><name>pine_20</name><pose>2 14 0 0 0 -0.6</pose></include>
    <include><uri>model://pine_tree</uri><name>pine_21</name><pose>10 14 0 0 0 0.3</pose></include>
    <include><uri>model://pine_tree</uri><name>pine_22</name><pose>16 13 0 0 0 -0.8</pose></include>




    <!-- The target lies on its side beneath nearby trees rather than in the open. -->
    <include>
      <uri>model://person_standing</uri>
      <name>person_target</name>
      <pose>5.0 3.2 0.04 0 1.5708 0.35</pose>
    </include>
    <include><uri>model://pine_tree</uri><name>target_tree_west</name><pose>2.7 2.1 0 0 0 0.4</pose></include>
    <include><uri>model://pine_tree</uri><name>target_tree_north</name><pose>5.2 6.3 0 0 0 -0.5</pose></include>
    <include><uri>model://pine_tree</uri><name>target_tree_east</name><pose>8.5 3.5 0 0 0 0.8</pose></include>
    <include><uri>model://pine_tree</uri><name>target_tree_south</name><pose>5.8 0.3 0 0 0 -0.2</pose></include>
  </world>
</sdf>
