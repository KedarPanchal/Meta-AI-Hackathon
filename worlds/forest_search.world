    <include><uri>model://rock_05</uri><name>rock_scatter_05</name><pose>6 18 1.499 0 0 -0.42</pose><static>true</static></include>
    <include><uri>model://rock_05</uri><name>rock_scatter_06</name><pose>-40 6 0.289 0 0 -1.37</pose><static>true</static></include>
